# Get a free NPS API key at https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=your_nps_api_key_here

# Optional: Recreation.gov / RIDB key for richer campground data
# Sign up at https://ridb.recreation.gov/
# RIDB_API_KEY=

# NextAuth — Google OAuth sign-in
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
